# ─────────────────────────────────────────────────────────────
# ShubhInvite – environment variables
# Copy this file to `.env.local` (never commit .env.local)
# ─────────────────────────────────────────────────────────────

# REQUIRED – PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# REQUIRED on Vercel – public URL of the site (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── OPTIONAL ────────────────────────────────────────────────
# Stock photo providers. The app already ships with a free built-in
# illustration + curated photo library, so these are NOT required.
# Add them only if you want a bigger photo search inside the editor.

# https://www.pexels.com/api/  (free, 200 requests/hour)
PEXELS_API_KEY=

# https://unsplash.com/developers  (free, 50 requests/hour)
UNSPLASH_ACCESS_KEY=
