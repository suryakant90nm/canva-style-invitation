# ─────────────────────────────────────────────────────────────
# ShubhInvite – environment variables
# Copy this file to `.env.local` for local development.
# NEVER commit .env or .env.local (both are git-ignored).
# ─────────────────────────────────────────────────────────────

# ── ALL OPTIONAL ────────────────────────────────────────────
# The app runs with ZERO environment variables. Templates are bundled
# in code; designs are kept in the browser + server memory.

# Super-admin panel at /admin  (min 6 chars; use a long random string)
ADMIN_PASSWORD=

# Recommended for production (SEO): public URL of the site, no trailing slash.
# Used for canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL. Adds cross-device persistence for "My designs"
# and community templates. Tables + 70 templates are created automatically.
# Free providers: neon.tech · supabase.com · vercel.com/storage
DATABASE_URL=

# Optional: bigger stock-photo search inside the editor.
# A free curated photo library is already built in, so these are not required.
# https://www.pexels.com/api/        (free, 200 req/hour)
PEXELS_API_KEY=
# https://unsplash.com/developers    (free, 50 req/hour)
UNSPLASH_ACCESS_KEY=
